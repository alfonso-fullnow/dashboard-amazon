<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Reporte Fullnow - Sem 1, 2026</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        body { background-color: #111827; color: #f3f4f6; font-family: 'Inter', sans-serif; }
        .card { background-color: #1f2937; border: 1px solid #374151; border-radius: 12px; padding: 24px; box-shadow: 0 4px 6px rgba(0,0,0,0.3); }
        .metric-label { color: #9ca3af; font-size: 0.875rem; font-weight: 500; margin-bottom: 0.5rem; }
        .metric-value { font-size: 2rem; font-weight: 700; color: white; }
        .metric-sub { font-size: 0.75rem; margin-top: 0.5rem; }
        
        /* Badges */
        .badge { padding: 4px 10px; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; display: inline-block; }
        .badge-red { background-color: #7f1d1d; color: #fca5a5; border: 1px solid #b91c1c; }
        .badge-green { background-color: #14532d; color: #86efac; border: 1px solid #15803d; }
        .badge-yellow { background-color: #713f12; color: #fde047; border: 1px solid #a16207; }

        /* Table */
        th { color: #d1d5db; font-weight: 600; text-transform: uppercase; font-size: 0.75rem; letter-spacing: 0.05em; }
        td { color: #e5e7eb; font-size: 0.875rem; vertical-align: middle; }
        tr:hover td { background-color: #374151; }
        
        /* Competitor Cards */
        .comp-card { background-color: #283040; border-left: 4px solid; padding: 15px; margin-bottom: 10px; border-radius: 6px; }
        .comp-card.price { border-color: #facc15; }
        .comp-card.rating { border-color: #f87171; }
        .comp-card.listing { border-color: #60a5fa; }
    </style>
</head>
<body class="p-4 md:p-8 max-w-7xl mx-auto">

    <div class="flex flex-col md:flex-row justify-between items-start md:items-center mb-8 gap-4">
        <div>
            <h1 class="text-3xl font-bold tracking-tight">Dashboard Semanal de Rendimiento</h1>
            <p class="text-gray-400 mt-1">Periodo: 29 Diciembre 2025 - 4 Enero 2026 | <span class="text-blue-400">Vista Ejecutiva</span></p>
        </div>
        <div class="flex gap-2">
            <span class="badge badge-red">Alert: Refunds 15.46%</span>
            <span class="badge badge-yellow">Low Margin: 2.72%</span>
        </div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-4 gap-4 mb-8">
        <div class="card">
            <p class="metric-label">Ventas Totales</p>
            <p class="metric-value">$276,968</p>
            <p class="metric-sub text-green-400">7,911 Unidades vendidas</p>
        </div>
        <div class="card">
            <p class="metric-label">Net Profit (Total)</p>
            <p class="metric-value text-yellow-400">$7,545</p>
            <p class="metric-sub text-gray-400">ROI: 11.59%</p>
        </div>
        <div class="card">
            <p class="metric-label">Global TACOS</p>
            <p class="metric-value text-red-400">15.27%</p>
            <p class="metric-sub text-gray-400">Objetivo ideal: < 12%</p>
        </div>
        <div class="card border-red-900">
            <p class="metric-label">Global Margin</p>
            <p class="metric-value text-red-400">2.72%</p>
            <p class="metric-sub text-gray-400">Impactado por Fees/Ads/Refunds</p>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-2 gap-6 mb-8">
        <div class="card">
            <div class="flex justify-between mb-4">
                <h3 class="font-bold text-lg">Profit Real por Mercado (USD Est.)</h3>
                <span class="text-xs text-gray-500">*Conversión divisa aplicada</span>
            </div>
            <div class="h-64">
                <canvas id="profitMarketChart"></canvas>
            </div>
            <p class="text-xs text-gray-400 mt-3 text-center">US y CA en negativo esta semana. Europa (FR/IT/ES) sostiene el profit.</p>
        </div>

        <div class="card">
            <h3 class="font-bold text-lg mb-4">Mapa de Rendimiento (Todos los Mercados)</h3>
            <div class="h-64">
                <canvas id="scatterChart"></canvas>
            </div>
            <div class="flex justify-center gap-4 mt-2 text-xs text-gray-400">
                <div class="flex items-center gap-1"><div class="w-3 h-3 rounded-full bg-green-500"></div> Rentable</div>
                <div class="flex items-center gap-1"><div class="w-3 h-3 rounded-full bg-red-500"></div> Pérdida</div>
            </div>
        </div>
    </div>

    <div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
        
        <div class="card lg:col-span-1">
            <h3 class="font-bold text-lg mb-4 text-white flex items-center gap-2">
                <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"></path></svg>
                Amenazas Competitivas
            </h3>
            
            <div class="comp-card rating">
                <div class="flex justify-between">
                    <span class="font-bold text-sm text-white">Ratings & Reviews</span>
                    <span class="text-xs text-red-400 font-bold">US/CA</span>
                </div>
                <p class="text-xs text-gray-300 mt-1"><strong>Aotto, Hotlogic, Rottogoon</strong> nos ganan en rating.</p>
                <p class="text-xs text-gray-400 mt-2 italic">"Tener 3.9/4.0 estrellas nos está limitando vs sus 4.5+"</p>
                <div class="mt-2 text-xs bg-gray-700 p-1 rounded text-center">Impacto: Siena</div>
            </div>

            <div class="comp-card price">
                <div class="flex justify-between">
                    <span class="font-bold text-sm text-white">Guerra de Precios</span>
                    <span class="text-xs text-yellow-400 font-bold">EU (IT/ES)</span>
                </div>
                <p class="text-xs text-gray-300 mt-1"><strong>Beper, Anykuu, Esohot</strong> mantienen precios agresivos.</p>
                <p class="text-xs text-gray-400 mt-2 italic">"Competencia fuerte en precio nos obliga a ajustar márgenes."</p>
                <div class="mt-2 text-xs bg-gray-700 p-1 rounded text-center">Impacto: Bari, Napoli</div>
            </div>

            <div class="comp-card listing">
                <div class="flex justify-between">
                    <span class="font-bold text-sm text-white">Oferta Irresistible</span>
                    <span class="text-xs text-blue-400 font-bold">Global</span>
                </div>
                <p class="text-xs text-gray-300 mt-1"><strong>Sohida, Herrfilk, Dupasu</strong> siguen fuertes.</p>
                <p class="text-xs text-gray-400 mt-2 italic">"Debemos mejorar listings para ser oferta irresistible."</p>
            </div>
        </div>

        <div class="card lg:col-span-2 overflow-hidden flex flex-col">
            <div class="flex justify-between items-center mb-4">
                <h3 class="font-bold text-lg">Estado de Productos y Decisiones</h3>
                <div class="flex gap-1">
                    <button onclick="filterTable('all')" class="px-3 py-1 text-xs bg-gray-700 hover:bg-gray-600 rounded text-white">Todos</button>
                    <button onclick="filterTable('US')" class="px-3 py-1 text-xs bg-blue-900 hover:bg-blue-800 rounded text-blue-100">US</button>
                    <button onclick="filterTable('EU')" class="px-3 py-1 text-xs bg-indigo-900 hover:bg-indigo-800 rounded text-indigo-100">EU</button>
                    <button onclick="filterTable('CA')" class="px-3 py-1 text-xs bg-red-900 hover:bg-red-800 rounded text-red-100">CA</button>
                </div>
            </div>
            
            <div class="overflow-y-auto pr-2" style="max-height: 400px;">
                <table class="w-full text-left">
                    <thead class="sticky top-0 bg-gray-800 z-10">
                        <tr>
                            <th class="p-3">Mkt</th>
                            <th class="p-3">Producto</th>
                            <th class="p-3">Status / Problema</th>
                            <th class="p-3">Decisión Tomada</th>
                            <th class="p-3 text-center">Nivel</th>
                        </tr>
                    </thead>
                    <tbody id="productsBody" class="divide-y divide-gray-700 text-sm">
                        </tbody>
                </table>
            </div>
        </div>
    </div>

    <script>
        // --- DATA ---
        // Datos extraídos para la semana 29 Dic - 4 Ene
        // Conversiones aprox: EUR 1.05, GBP 1.25, CAD 0.72
        
        const products = [
            // US Data
            { mkt: 'US', name: 'Bari', rev: 2480, profit: -2121, status: 'Bad Rank - Poor Sales', decision: 'Mantener', crit: true },
            { mkt: 'US', name: 'Bari Bag', rev: 94519, profit: 3107, status: 'Good Rank - Great Sales', decision: 'Mantener', crit: false },
            { mkt: 'US', name: 'Napoli', rev: 27499, profit: -715, status: 'Bad Rank - Great Sales', decision: 'Mantener', crit: true },
            { mkt: 'US', name: 'Siena', rev: 1039, profit: -1142, status: 'Rating Issue (4.0)', decision: 'Mantener precio reducido', crit: true },
            { mkt: 'US', name: 'Palermo', rev: 140, profit: -587, status: 'Not Indexed / PPC Heavy', decision: 'Mantener estrategia', crit: true },
            { mkt: 'US', name: 'Maps', rev: 378, profit: 2, status: 'Bad Rank - Poor Sales', decision: 'Mantener', crit: true },
            
            // CA Data (USD Values approx for chart, Raw for table display?) 
            // I will use RAW for table, Approx for logic/charts
            { mkt: 'CA', name: 'Bari', rev: 1437, profit: -323, status: 'High Refunds / Bad Rank', decision: 'Bajar precio a CA$36.99', crit: true },
            { mkt: 'CA', name: 'Bari Bag', rev: 14807, profit: -220, status: 'Good Rank - Great Sales', decision: 'Mantener', crit: true },
            { mkt: 'CA', name: 'Napoli', rev: 5792, profit: 268, status: 'Good Rank - Great Sales', decision: 'Mantener', crit: false },
            { mkt: 'CA', name: 'Siena', rev: 95, profit: 14, status: 'Price/Rating Issue', decision: 'Bajar precio a CA$44.99', crit: true },

            // UK Data (GBP)
            { mkt: 'UK', name: 'Bari', rev: 2394, profit: 253, status: 'Good Rank - Poor Sales', decision: 'Reducir margen al 10%', crit: false },
            { mkt: 'UK', name: 'Bari Bag', rev: 11063, profit: -110, status: 'Good Rank - Great Sales', decision: 'Mantener', crit: true },
            { mkt: 'UK', name: 'Napoli', rev: 6191, profit: 945, status: 'Good Rank - Great Sales', decision: 'Mantener', crit: false },

            // EU Data (EUR)
            { mkt: 'IT', name: 'Bari', rev: 13189, profit: 1665, status: 'Good Rank - #1', decision: 'Reducir margen al 12%', crit: false },
            { mkt: 'IT', name: 'Bari Bag', rev: 8728, profit: 755, status: 'Bad Rank - Great Sales', decision: 'Mantener', crit: false },
            { mkt: 'IT', name: 'Napoli', rev: 4570, profit: 425, status: 'Bad Rank - Great Sales', decision: 'Mantener', crit: false },

            { mkt: 'FR', name: 'Bari', rev: 15929, profit: 1905, status: 'Good Rank - #1', decision: 'Mantener', crit: false },
            { mkt: 'FR', name: 'Bari Bag', rev: 6387, profit: 791, status: 'Bad Rank - Great Sales', decision: 'Reducir margen al 13%', crit: false },
            { mkt: 'FR', name: 'Napoli', rev: 5783, profit: 636, status: 'Bad Rank - Great Sales', decision: 'Reducir margen al 13%', crit: false },

            { mkt: 'DE', name: 'Bari', rev: 1301, profit: 1, status: 'Bad Rank - Poor Sales', decision: 'Reducir margen al 13%', crit: true },
            { mkt: 'DE', name: 'Bari Bag', rev: 1522, profit: -70, status: 'Bad Rank - Poor Sales', decision: 'Mantener', crit: true },
            { mkt: 'DE', name: 'Napoli', rev: 3343, profit: 333, status: 'Good Rank - Great Sales', decision: 'Reducir margen al 13%', crit: false },

            { mkt: 'ES', name: 'Bari', rev: 9355, profit: 625, status: 'Bad Rank - Great Sales', decision: 'Subir margen al 13%', crit: false },
            { mkt: 'ES', name: 'Bari Bag', rev: 14494, profit: 1620, status: 'Bad Rank - Great Sales', decision: 'Mantener', crit: false },
            { mkt: 'ES', name: 'Napoli', rev: 5657, profit: 224, status: 'Bad Rank - Great Sales', decision: 'Mantener', crit: false }
        ];

        // --- CHART 1: PROFIT BY MARKET ---
        // Summing up profits per market (Approx USD for visualization)
        // US: -2121 + 3107 - 715 - 1142 - 587 + 2 = -1,456
        // CA: (-323 - 220 + 268 + 14) * 0.72 = -261 * 0.72 = -188
        // UK: (253 - 110 + 945) * 1.25 = 1088 * 1.25 = 1,360
        // DE: (1 - 70 + 333) * 1.05 = 264 * 1.05 = 277
        // FR: (1905 + 791 + 636) * 1.05 = 3332 * 1.05 = 3,498
        // IT: (1665 + 755 + 425) * 1.05 = 2845 * 1.05 = 2,987
        // ES: (625 + 1620 + 224) * 1.05 = 2469 * 1.05 = 2,592
        
        const ctxMkt = document.getElementById('profitMarketChart').getContext('2d');
        new Chart(ctxMkt, {
            type: 'bar',
            data: {
                labels: ['FR', 'IT', 'ES', 'UK', 'DE', 'CA', 'US'],
                datasets: [{
                    label: 'Profit Real (USD Est.)',
                    data: [3498, 2987, 2592, 1360, 277, -188, -1456],
                    backgroundColor: [
                        '#10b981', '#10b981', '#10b981', '#10b981', '#10b981', 
                        '#ef4444', '#ef4444' // Red for negative
                    ],
                    borderRadius: 4
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: { legend: { display: false } },
                scales: {
                    y: { grid: { color: '#374151' }, ticks: { color: '#9ca3af', callback: v => '$' + v } },
                    x: { grid: { display: false }, ticks: { color: '#fff', font: { weight: 'bold' } } }
                }
            }
        });

        // --- CHART 2: SCATTER PLOT ALL PRODUCTS ---
        const scatterData = products.map(p => ({
            x: p.rev, // Keeping raw currency value for log scale is fine for visual distro
            y: p.profit,
            label: `${p.mkt} ${p.name}`,
            bg: p.profit > 0 ? '#10b981' : '#ef4444'
        }));

        const ctxScatter = document.getElementById('scatterChart').getContext('2d');
        new Chart(ctxScatter, {
            type: 'scatter',
            data: {
                datasets: [{
                    label: 'Productos',
                    data: scatterData,
                    backgroundColor: c => c.raw.bg,
                    pointRadius: 6,
                    pointHoverRadius: 8
                }]
            },
            options: {
                responsive: true,
                maintainAspectRatio: false,
                plugins: {
                    tooltip: {
                        backgroundColor: '#1f2937',
                        titleColor: '#fff',
                        bodyColor: '#d1d5db',
                        callbacks: {
                            label: (ctx) => {
                                const p = ctx.raw;
                                return `${p.label}: Rev ${p.x.toLocaleString()} | Profit ${p.y.toLocaleString()}`;
                            }
                        }
                    },
                    legend: { display: false }
                },
                scales: {
                    x: { 
                        type: 'logarithmic', 
                        title: { display: true, text: 'Revenue (Log Scale)', color: '#6b7280' },
                        grid: { color: '#374151' },
                        ticks: { color: '#9ca3af', callback: v => v.toLocaleString() }
                    },
                    y: { 
                        title: { display: true, text: 'Profit (Local Curr)', color: '#6b7280' },
                        grid: { color: '#374151' },
                        ticks: { color: '#9ca3af' }
                    }
                }
            }
        });

        // --- TABLE LOGIC ---
        const tableBody = document.getElementById('productsBody');

        function renderTable(filter) {
            tableBody.innerHTML = '';
            let filteredProducts = products;
            
            if (filter !== 'all') {
                if (filter === 'EU') {
                    filteredProducts = products.filter(p => ['UK','IT','FR','DE','ES'].includes(p.mkt));
                } else {
                    filteredProducts = products.filter(p => p.mkt === filter);
                }
            }

            filteredProducts.forEach(p => {
                const row = document.createElement('tr');
                row.className = 'border-b border-gray-700 last:border-0 hover:bg-gray-800 transition-colors';
                
                // Determine Badge
                let badge = p.crit 
                    ? `<span class="badge badge-red">🚨 Critical</span>` 
                    : `<span class="badge badge-green">🚀 Top</span>`;
                
                // Override if profitable but not critical
                if(!p.crit && p.profit < 0) badge = `<span class="badge badge-yellow">⚠️ Watch</span>`;

                row.innerHTML = `
                    <td class="p-3"><span class="font-bold text-gray-400">${p.mkt}</span></td>
                    <td class="p-3 font-bold text-white">${p.name}</td>
                    <td class="p-3 text-gray-300 text-xs">${p.status}</td>
                    <td class="p-3 text-blue-300 text-xs">${p.decision}</td>
                    <td class="p-3 text-center">${badge}</td>
                `;
                tableBody.appendChild(row);
            });
        }

        function filterTable(region) {
            renderTable(region);
        }

        // Init
        renderTable('all');

    </script>
</body>
</html>
